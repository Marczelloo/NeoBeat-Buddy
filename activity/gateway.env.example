ACTIVITY_ENABLED=true
ACTIVITY_HOST=127.0.0.1
ACTIVITY_PORT=8787
# Optional: realtime player-state heartbeat in milliseconds. Event updates are immediate.
ACTIVITY_STATE_HEARTBEAT_MS=5000
ACTIVITY_ALLOW_DEV=true
ACTIVITY_DEV_GUILD_ID=demo
ACTIVITY_DEV_USER_ID=local-user
ACTIVITY_ALLOWED_ORIGINS=http://127.0.0.1:5173
ACTIVITY_REDIRECT_URI=https://127.0.0.1

# Keep this only in the bot environment. Never put it in the Activity frontend.
# DISCORD_CLIENT_SECRET=from-the-Discord-Developer-Portal
